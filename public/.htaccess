# scanfence.com static frontend (Astro)
# Served from /home/ywxmbssz/scanfence-frontend/ on flokinet shared hosting.
# This file is copied verbatim into dist/ by Astro and deployed by CI.

RewriteEngine On

# 0a) HOST CANONICALIZATION — must run before every other rule.
#
#     Until 2026-08 the site answered 200 on all four host/protocol combos
#     (http, https, http://www, https://www), so 1,092 URLs were reachable as
#     ~4,368. GSC confirmed Google indexed the duplicates rather than folding
#     them into the canonical: http://…/how-does-a-qr-code-work-step-by-step/
#     had 140 impressions and https://www…/importance-of-qr-code-analytics/
#     had 37, both independent of their https+non-www originals.
#     rel=canonical alone did not consolidate them. HSTS does not help —
#     Googlebot ignores it for canonicalization, and it says nothing about www.
#
#     LOOP SAFETY: nginx sits in front of Apache here, so %{HTTPS} may read
#     "off" on requests that arrived over TLS. The scheme rule therefore also
#     accepts X-Forwarded-Proto before redirecting. If the proxy sends neither
#     signal this rule would loop, so verify immediately after the first deploy:
#       curl -sI http://scanfence.com/       | head -1   # expect 301
#       curl -sI https://www.scanfence.com/  | head -1   # expect 301
#       curl -sI https://scanfence.com/      | head -1   # expect 200, NOT 301
#     A 301 on the third line means the scheme rule is looping — delete rule
#     0a-i below and redeploy; 0a-ii (www) is loop-safe and can stay.

# 0a-i) http -> https
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 0a-ii) www -> non-www (loop-safe: the target host differs from the matched one)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 0) Disable mod_pagespeed on this vhost.
#    The site is already an optimized static Astro build; mod_pagespeed adds
#    nothing and was injecting a /mod_pagespeed_beacon/ script that 404s
#    (doubled-slash URL produced by the host vhost config).
<IfModule pagespeed_module>
  ModPagespeed off
</IfModule>

# 1) 301 legacy date-based WP permalinks -> Astro /blog/<slug>/
#    Example: /2026/03/05/foo-bar/  ->  /blog/foo-bar/
RewriteRule ^([0-9]{4})/([0-9]{2})/([0-9]{2})/([^/]+)/?$ /blog/$4/ [R=301,L]

# 2) 301 legacy English legal slugs -> current slugs
RewriteRule ^privacy/?$         /datenschutzerklaerung/   [R=301,L]
RewriteRule ^privacy-policy/?$  /datenschutzerklaerung/   [R=301,L]
RewriteRule ^terms/?$           /terms-and-conditions/    [R=301,L]
RewriteRule ^terms-of-service/?$ /terms-and-conditions/   [R=301,L]

# 2b) 301 the retired founder page to the homepage (page removed from the site)
RewriteRule ^about-raphael/?$ / [R=301,L]
RewriteRule ^(zh|es|ar|pt|id|fr|ja|ru|de|nl|hi)/about-raphael/?$ /$1/ [R=301,L]

# 3) 301 legacy blog pagination /blog/N/ -> /blog/page/N/  (N=2..9)
RewriteRule ^blog/([0-9])/?$    /blog/page/$1/            [R=301,L]

# 3b) 301 dangling links to a deleted blog post (referenced inside 3 other posts).
#     Substitute the closest topical match so users still land somewhere useful.
RewriteRule ^blog/qr-codes-restaurant-menus-3/?$  /blog/using-qr-codes-on-menus-best-practices-for-restaurants/  [R=301,L]
RewriteRule ^qr-codes-restaurant-menus-3/?$       /blog/using-qr-codes-on-menus-best-practices-for-restaurants/  [R=301,L]

# 3c) 301 posts consolidated into a stronger article (2026-08-23).
#     Slugs and the reasoning live in src/seo/consolidated-posts.ts;
#     they are no longer built, so these rules catch the indexed old URLs.
#     Two rules per pair: the default-locale path and the localised ones.
#     The bare (no /blog/ prefix) form is covered by rule 1 only for date
#     URLs, so it is listed explicitly here too.

RewriteRule ^blog/importance-of-qr-code-analytics/?$ /blog/best-qr-code-analytics-tools/ [R=301,L]
RewriteRule ^(zh|es|ar|pt|id|fr|ja|ru|de|nl|hi)/blog/importance-of-qr-code-analytics/?$ /$1/blog/best-qr-code-analytics-tools/ [R=301,L]
RewriteRule ^importance-of-qr-code-analytics/?$ /blog/best-qr-code-analytics-tools/ [R=301,L]
RewriteRule ^blog/understanding-qr-code-analytics/?$ /blog/best-qr-code-analytics-tools/ [R=301,L]
RewriteRule ^(zh|es|ar|pt|id|fr|ja|ru|de|nl|hi)/blog/understanding-qr-code-analytics/?$ /$1/blog/best-qr-code-analytics-tools/ [R=301,L]
RewriteRule ^understanding-qr-code-analytics/?$ /blog/best-qr-code-analytics-tools/ [R=301,L]
RewriteRule ^blog/choosing-qr-code-apps-restaurants/?$ /blog/choosing-the-right-qr-code-app-for-your-restaurant/ [R=301,L]
RewriteRule ^(zh|es|ar|pt|id|fr|ja|ru|de|nl|hi)/blog/choosing-qr-code-apps-restaurants/?$ /$1/blog/choosing-the-right-qr-code-app-for-your-restaurant/ [R=301,L]
RewriteRule ^choosing-qr-code-apps-restaurants/?$ /blog/choosing-the-right-qr-code-app-for-your-restaurant/ [R=301,L]
RewriteRule ^blog/best-5-free-qr-code-apps-for-restaurants-in-2026/?$ /blog/choosing-the-right-qr-code-app-for-your-restaurant/ [R=301,L]
RewriteRule ^(zh|es|ar|pt|id|fr|ja|ru|de|nl|hi)/blog/best-5-free-qr-code-apps-for-restaurants-in-2026/?$ /$1/blog/choosing-the-right-qr-code-app-for-your-restaurant/ [R=301,L]
RewriteRule ^best-5-free-qr-code-apps-for-restaurants-in-2026/?$ /blog/choosing-the-right-qr-code-app-for-your-restaurant/ [R=301,L]
RewriteRule ^blog/how-does-a-qr-code-work-step-by-step/?$ /blog/how-qr-codes-work-a-simple-beginners-guide/ [R=301,L]
RewriteRule ^(zh|es|ar|pt|id|fr|ja|ru|de|nl|hi)/blog/how-does-a-qr-code-work-step-by-step/?$ /$1/blog/how-qr-codes-work-a-simple-beginners-guide/ [R=301,L]
RewriteRule ^how-does-a-qr-code-work-step-by-step/?$ /blog/how-qr-codes-work-a-simple-beginners-guide/ [R=301,L]


# 3d) Live product demo — the ScanFence app as a single-page app under
#     /demo/app/ (copied in by scripts/update-app-demo.sh). Any path that is
#     not a real file gets the app shell, so deep links like
#     /demo/app/qr-codes load. Must run before rule 5, which would otherwise
#     append a slash and 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpe?g|gif|svg|ico|webp|woff2?|map)$ [NC]
RewriteRule ^demo/app/ /demo/app/index.html [L]

# 3e) The old hand-built product tour lived at /demo/ (and /<locale>/demo/)
#     for a few hours on 2026-09-24; send those links to the real demo.
RewriteRule ^demo/?$ /demo/app/ [R=301,L]
RewriteRule ^(zh|es|ar|pt|id|fr|ja|ru|de|nl|hi)/demo/?$ /demo/app/ [R=301,L]

# 3f) No directory listings. The host has autoindex on, so a folder without
#     an index.html (/assets/, /_astro/, /blog/page/ …) printed its file
#     list. Done with mod_rewrite rather than "Options -Indexes", which this
#     shared host may not allow in .htaccess (that would 500 the whole site).
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

# 4) Strip trailing index.html (clean URLs in the address bar)
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 5) Add trailing slash to bare directory requests (matches Astro output).
#    Excludes static asset extensions AND .html to prevent ErrorDocument loop.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.(html|css|js|png|jpe?g|gif|svg|ico|webp|woff2?|xml|txt|map|pdf)$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L]

ErrorDocument 404 /404.html

# 6) Cache lifetimes — hashed Astro bundles are immutable; HTML revalidates often.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
  ExpiresByType image/x-icon            "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  # 7) Strong HSTS — addresses Best Practices "Use a strong HSTS policy".
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>
