---
import { resolveLocale, localizedUrl, t } from '../i18n/t';

const locale = resolveLocale(Astro.currentLocale);

const scans = [
  { time: '09:42', city: 'PARIS',    state: 'ROUTED → menu/fr',         tone: 'signal' },
  { time: '09:43', city: 'BUDAPEST', state: 'BLOCKED · out-of-window',  tone: 'vermil' },
  { time: '09:44', city: 'LONDON',   state: 'ROUTED → menu/en',         tone: 'signal' },
  { time: '09:45', city: 'LYON',     state: 'ROUTED → menu/fr',         tone: 'signal' },
  { time: '09:46', city: 'ZURICH',   state: 'ROUTED → menu/de',         tone: 'signal' },
];
---

<a href="/demo/app/" class="hero-demo" aria-label={t('hero.demo.aria', locale)}>
  <span class="hero-demo-label">
    <span class="hero-demo-dot" aria-hidden="true"></span>
    {t('hero.demo.label', locale)}
  </span>
  <span class="hero-demo-window">
    <span class="hero-demo-bar" aria-hidden="true">
      <i></i><i></i><i></i>
      <span class="hero-demo-url">app.scanfence.com<span class="hero-demo-url-path">/dashboard</span></span>
    </span>
    <picture>
      <source
        media="(max-width: 600px)"
        srcset="/images/live-demo-dashboard-mobile.webp"
        width="780"
        height="1576"
      />
      <img
        src="/images/live-demo-dashboard.webp"
        srcset="/images/live-demo-dashboard-1440.webp 1440w, /images/live-demo-dashboard.webp 2880w"
        sizes="100vw"
        width="2880"
        height="1800"
        alt={t('hero.demo.alt', locale)}
        fetchpriority="high"
      />
    </picture>
    <span class="hero-demo-cta">
      {t('hero.demo.cta', locale)}
    </span>
  </span>
</a>

<section class="hero" id="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{t('hero.eyebrow', locale)}</span>
      <h1>
        {t('hero.heading.line1', locale)}<br />
        <span class="serif-accent">{t('hero.heading.line2', locale)}</span>
      </h1>
      <p class="hero-lede">{t('hero.lede', locale)}</p>
      <div class="hero-cta">
        <a href="https://app.scanfence.com/signup" class="btn btn-primary btn-lg">{t('hero.ctaPrimary', locale)}</a>
        <a href={localizedUrl('/pricing/', locale)} class="btn btn-ghost btn-lg">{t('hero.ctaSecondary', locale)}</a>
      </div>
      <p class="hero-note">{t('hero.note', locale)}</p>
    </div>

    <aside class="hero-receipt" aria-label={t('hero.receiptAria', locale)}>
      <header class="hero-receipt-header">
        <span class="eyebrow eyebrow--mute">{t('hero.receipt.eyebrow', locale)}</span>
        <span class="hero-receipt-dot" aria-hidden="true"></span>
      </header>
      <ul class="hero-receipt-list">
        {scans.map(s => (
          <li class={`hero-receipt-row hero-receipt-row--${s.tone}`}>
            <span class="hero-receipt-time">{s.time}</span>
            <span class="hero-receipt-city">{s.city}</span>
            <span class="hero-receipt-state">{s.state}</span>
          </li>
        ))}
      </ul>
      <footer class="hero-receipt-footer">
        <span>{t('hero.receipt.regionLabel', locale)}</span>
        <span>{t('hero.receipt.latency', locale)}</span>
      </footer>
    </aside>
  </div>
</section>
