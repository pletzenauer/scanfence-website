---
import DemoApp from './DemoApp.astro';
import { resolveLocale, localizedUrl, t } from '../i18n/t';

const locale = resolveLocale(Astro.currentLocale);
---

<section class="demo-teaser section">
  <div class="container">
    <header class="receipt-header">
      <span class="eyebrow">{t('demo.teaser.eyebrow', locale)}</span>
      <h2>
        {t('demo.teaser.line1', locale)}<br />
        <span class="serif-accent">{t('demo.teaser.line2', locale)}</span>
      </h2>
    </header>
    <DemoApp id="demo-home" initial="geofence" />
    <p class="demo-teaser-link">
      <a href={localizedUrl('/demo/', locale)} class="btn btn-ghost btn-lg" data-demo-cta="full-tour">{t('demo.teaser.link', locale)}</a>
    </p>
  </div>
</section>
