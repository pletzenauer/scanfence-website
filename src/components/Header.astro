---
import { resolveLocale, localizedUrl, stripLocalePrefix, t } from '../i18n/t';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = resolveLocale(Astro.currentLocale);
const { path: canonicalPath } = stripLocalePrefix(Astro.url.pathname);
const isActive = (href: string) => {
  if (href === '/') return canonicalPath === '/';
  return canonicalPath.startsWith(href);
};
// The help docs exist in English only (src/pages/documentation/).
const navHref = (href: string) => (href === '/documentation/' ? href : localizedUrl(href, locale));
const nav = [
  { href: '/',               key: 'nav.home' },
  { href: '/features/',      key: 'nav.features' },
  { href: '/pricing/',       key: 'nav.pricing' },
  { href: '/faq/',           key: 'nav.faq' },
  { href: '/documentation/', key: 'nav.docs' },
  { href: '/blog/',          key: 'nav.blog' },
  { href: '/contact/',       key: 'nav.contact' },
];
---

<header class="header">
  <div class="container">
    <a href={localizedUrl('/', locale)} class="header-logo" aria-label="ScanFence — home">
      <span class="header-logo-mark" aria-hidden="true"></span>
      <span class="header-logo-text">ScanFence</span>
    </a>

    <nav class="header-nav" aria-label={t('nav.primary', locale)}>
      {nav.map(item => (
        <a
          href={navHref(item.href)}
          class:list={[{ 'is-active': isActive(item.href) }]}
        >{t(item.key, locale)}</a>
      ))}
    </nav>

    <div class="header-actions">
      <LanguageSwitcher />
      <a href="/demo/app/" class="header-link">{t('nav.liveDemo', locale)}</a>
      <a href="https://app.scanfence.com/login" class="header-link">{t('nav.signIn', locale)}</a>
      <a href="https://app.scanfence.com/signup" class="btn btn-primary btn-nav">{t('nav.startPlan', locale)}</a>
    </div>

    <button class="theme-toggle" type="button" id="themeToggle" aria-label={t('nav.toggleTheme', locale)} title={t('nav.toggleTheme', locale)} aria-pressed="false">
      <svg class="theme-toggle__moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
      </svg>
      <svg class="theme-toggle__sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
      </svg>
    </button>

    <button class="mobile-toggle" aria-label={t('nav.toggleMenu', locale)} aria-controls="mobileMenu" aria-expanded="false" id="menuToggle">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  {nav.map(item => (
    <a
      href={navHref(item.href)}
      class:list={[{ 'is-active': isActive(item.href) }]}
    >{t(item.key, locale)}</a>
  ))}
  <hr class="rule-hard" />
  <LanguageSwitcher />
  <a href="/demo/app/">{t('nav.liveDemo', locale)}</a>
  <a href="https://app.scanfence.com/login">{t('nav.signIn', locale)}</a>
  <a href="https://app.scanfence.com/signup" class="btn btn-primary">{t('nav.startPlan', locale)}</a>
</div>

<script>
  // Same key and classes as the app, so the live demo at /demo/app/ (same
  // origin) follows whatever the visitor picked here, and vice versa.
  const themeToggle = document.getElementById('themeToggle');
  if (themeToggle) {
    const root = document.documentElement;
    const sync = () => themeToggle.setAttribute('aria-pressed', String(root.classList.contains('dark')));
    sync();
    themeToggle.addEventListener('click', () => {
      const next = root.classList.contains('dark') ? 'light' : 'dark';
      root.classList.toggle('dark', next === 'dark');
      root.classList.toggle('light', next === 'light');
      try { localStorage.setItem('scanfence-theme', next); } catch {}
      sync();
    });
  }

  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  if (menuToggle && mobileMenu) {
    let isOpen = false;
    menuToggle.addEventListener('click', () => {
      isOpen = !isOpen;
      mobileMenu.classList.toggle('active', isOpen);
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      const path = menuToggle.querySelector('svg path');
      if (path) {
        path.setAttribute('d', isOpen
          ? 'M6 18L18 6M6 6l12 12'
          : 'M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5'
        );
      }
    });
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        isOpen = false;
        mobileMenu.classList.remove('active');
        menuToggle.setAttribute('aria-expanded', 'false');
        const path = menuToggle.querySelector('svg path');
        if (path) path.setAttribute('d', 'M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5');
      });
    });
  }
</script>
