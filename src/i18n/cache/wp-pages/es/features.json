  "content": "\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"75\" class=\"elementor elementor-75\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-f2279f94 e-con-full e-flex e-con e-parent\" data-id=\"f2279f94\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-c07a428e elementor-widget__width-initial elementor-widget elementor-widget-html\" data-id=\"c07a428e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<style data-d01-pagehead>.d01-pagehead{max-width:1200px;margin:0 auto;padding:56px 32px 32px;display:flex;flex-direction:column;gap:24px;border-bottom:1px solid rgba(10,14,21,0.13);}.d01-pagehead-kicker{display:flex;justify-content:space-between;align-items:center;gap:24px;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:11px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#5B6470;}.d01-pagehead-kicker span:nth-child(2){color:#0A0E15;}.d01-pagehead-title{font-family:\"Geist\",sans-serif;font-weight:600;font-size:clamp(36px,5vw,68px);line-height:1.04;letter-spacing:-0.02em;color:#0A0E15;margin:0;max-width:18ch;}.d01-pagehead-title em{font-family:\"Newsreader\",Georgia,serif;font-style:italic;font-weight:400;color:#5B6470;}.d01-pagehead-tagline{font-family:\"Geist\",sans-serif;font-size:17px;line-height:1.55;color:#5B6470;max-width:60ch;margin:0;}@media(max-width:700px){.d01-pagehead{padding:32px 20px 24px;}.d01-pagehead-kicker{flex-wrap:wrap;gap:8px;}}</style><section class=\"d01-pagehead\"><div class=\"d01-pagehead-kicker\"><span>D01 · FEATURES</span><span>SCANFENCE / FEATURES</span><span>CAPABILITIES · LIMITS · BEHAVIOR</span></div><h1 class=\"d01-pagehead-title\">Todo lo que el <em>código puede hacer.</em></h1><p class=\"d01-pagehead-tagline\">Geovallas por GPS, enrutamiento por horario, redirecciones dinámicas, analítica, flujos de trabajo en equipo. El conjunto completo de funciones, sin relleno.</p></section>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-d57fb629 e-con-full e-flex e-con e-parent\" data-id=\"d57fb629\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-3ff8ef68 elementor-widget__width-initial elementor-widget elementor-widget-html\" data-id=\"3ff8ef68\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<style>.d01-fpage{max-width:1200px;margin:0 auto;padding:48px 32px 32px;display:flex;flex-direction:column;gap:64px;}.d01-fgroup{display:grid;grid-template-columns:1fr 2.4fr;gap:48px;align-items:start;border-top:1px solid rgba(10,14,21,0.13);padding-top:32px;}.d01-fgroup-head{display:flex;flex-direction:column;gap:8px;position:sticky;top:120px;}.d01-fgroup-id{font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:11px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#5B6470;}.d01-fgroup-id b{color:#0F8A5F;font-weight:500;}.d01-fgroup-name{font-family:\"Geist\",sans-serif;font-weight:600;font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;color:#0A0E15;margin:0;}.d01-fgroup-name em{font-family:\"Newsreader\",Georgia,serif;font-style:italic;font-weight:400;color:#5B6470;}.d01-fgroup-blurb{font-family:\"Geist\",sans-serif;font-size:14px;line-height:1.55;color:#5B6470;margin:8px 0 0;max-width:32ch;}.d01-fcards{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid rgba(10,14,21,0.13);}.d01-fcard{padding:28px 24px;border-right:1px solid rgba(10,14,21,0.13);background:#FAF7EC;display:flex;flex-direction:column;gap:12px;min-height:240px;}.d01-fcard:nth-child(3n){border-right:0;}.d01-fcard:nth-child(n+4){border-top:1px solid rgba(10,14,21,0.13);}.d01-fcard-id{font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:10px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#5B6470;}.d01-fcard-title{font-family:\"Geist\",sans-serif;font-weight:600;font-size:17px;line-height:1.3;letter-spacing:-0.01em;color:#0A0E15;margin:0;}.d01-fcard-desc{font-family:\"Geist\",sans-serif;font-size:13px;line-height:1.55;color:#5B6470;margin:0;}.d01-fcard-tag{align-self:flex-start;font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:9px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#5B6470;border:1px solid rgba(10,14,21,0.13);padding:4px 8px;margin-top:auto;}@media(max-width:1100px){.d01-fgroup{grid-template-columns:1fr;gap:24px;}.d01-fgroup-head{position:static;}}@media(max-width:900px){.d01-fcards{grid-template-columns:1fr;}.d01-fcard{border-right:0 !important;border-top:1px solid rgba(10,14,21,0.13);min-height:auto;}.d01-fcard:first-child{border-top:0;}.d01-fpage{padding:32px 20px;gap:40px;}}@media(max-width:1100px) and (min-width:901px){.d01-fcards{grid-template-columns:repeat(2,1fr);}.d01-fcard{border-right:1px solid rgba(10,14,21,0.13) !important;border-top:1px solid rgba(10,14,21,0.13);}.d01-fcard:first-child,.d01-fcard:nth-child(2){border-top:0;}.d01-fcard:nth-child(2n){border-right:0 !important;}}.d01-fcta{max-width:1200px;margin:0 auto;padding:32px 32px 80px;}.d01-fcta-inner{border:1px solid rgba(10,14,21,0.13);background:#FAF7EC;display:grid;grid-template-columns:1.4fr 1fr;gap:48px;padding:48px;align-items:center;}.d01-fcta-kicker{font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:11px;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:#5B6470;margin-bottom:16px;display:inline-flex;align-items:center;gap:6px;}.d01-fcta-kicker::before{content:\"\";display:inline-block;width:6px;height:6px;border-radius:50%;background:#0F8A5F;}.d01-fcta-headline{font-family:\"Geist\",sans-serif;font-weight:600;font-size:clamp(28px,3.4vw,44px);line-height:1.1;letter-spacing:-0.02em;color:#0A0E15;margin:0;}.d01-fcta-headline em{font-family:\"Newsreader\",Georgia,serif;font-style:italic;font-weight:400;color:#5B6470;}.d01-fcta-actions{display:flex;flex-direction:column;gap:8px;}.d01-fcta-actions a{font-family:\"JetBrains Mono\",ui-monospace,monospace;font-size:11px;font-weight:500;letter-spacing:1.6px;text-transform:uppercase;padding:14px 24px;text-decoration:none;border:1px solid #0A0E15;transition:background .15s,color .15s,border-color .15s;display:inline-flex;align-items:center;justify-content:center;gap:8px;}.d01-fcta-primary{background:#0F8A5F;border-color:#0F8A5F;color:#FAF7EC;}.d01-fcta-primary:hover{background:#0A0E15;border-color:#0A0E15;}.d01-fcta-secondary{background:transparent;color:#0A0E15;border-color:rgba(10,14,21,0.20);}.d01-fcta-secondary:hover{border-color:#0A0E15;}@media(max-width:800px){.d01-fcta-inner{grid-template-columns:1fr;padding:32px 24px;gap:32px;}.d01-fcta{padding:24px 20px 48px;}}</style><div class=\"d01-fpage\"><section class=\"d01-fgroup\"><div class=\"d01-fgroup-head\"><span class=\"d01-fgroup-id\"><b>01</b> · Grupo de capacidades</span><h2 class=\"d01-fgroup-name\">Gestión de <em>códigos QR.</em></h2><p class=\"d01-fgroup-blurb\">Lo básico, bien hecho: códigos editables, redirecciones inteligentes, creación a escala. Imprime una vez, reutiliza para siempre.</p></div><div class=\"d01-fcards\"><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">01 · Editable</span><h3 class=\"d01-fcard-title\">Códigos QR dinámicos</h3><p class=\"d01-fcard-desc\">Actualiza los destinos en cualquier momento sin volver a imprimir. Cambia URL, sustituye páginas de destino, lanza nuevas ofertas: el código impreso nunca cambia.</p><span class=\"d01-fcard-tag\">Edit · Version</span></article><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">02 · Routing</span><h3 class=\"d01-fcard-title\">Redirecciones inteligentes</h3><p class=\"d01-fcard-desc\">Enruta según el tipo de dispositivo, navegador, sistema operativo, idioma o reglas personalizadas. Envía a los usuarios de iOS a la App Store, a los de Android a Google Play y al resto a una página alternativa.</p><span class=\"d01-fcard-tag\">Device · Rules</span></article><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">03 · Bulk</span><h3 class=\"d01-fcard-title\">Generación masiva</h3><p class=\"d01-fcard-desc\">Genera cientos de códigos únicos a partir de un CSV. Diseñado para empaquetado de productos, campañas en múltiples ubicaciones e implementaciones a escala de evento.</p><span class=\"d01-fcard-tag\">CSV · At scale</span></article></div></section><section class=\"d01-fgroup\"><div class=\"d01-fgroup-head\"><span class=\"d01-fgroup-id\"><b>02</b> · Grupo de capacidades</span><h2 class=\"d01-fgroup-name\">Inteligencia <em>de ubicación.</em></h2><p class=\"d01-fgroup-blurb\">Las geovallas por GPS convierten un solo código en un código distinto en cada lugar. Define zonas, enruta por región, entrega contenido local.</p></div><div class=\"d01-fcards\"><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">04 · Geofence</span><h3 class=\"d01-fcard-title\">Geovallas por GPS</h3><p class=\"d01-fcard-desc\">Define límites virtuales por radio o polígono. Enruta de forma distinta cuando los escaneos ocurren dentro o fuera de la zona, con precisión a nivel de metro.</p><span class=\"d01-fcard-tag\">Radius · Polygon</span></article><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">05 · Local</span><h3 class=\"d01-fcard-title\">Contenido según la ubicación</h3><p class=\"d01-fcard-desc\">Muestra tiendas cercanas, precios locales, ofertas regionales y páginas de destino en el idioma correcto. El mismo código, localizado al instante.</p><span class=\"d01-fcard-tag\">Personalised</span></article><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">06 · Multi</span><h3 class=\"d01-fcard-title\">Enrutamiento multiubicación</h3><p class=\"d01-fcard-desc\">Un código por franquicia, sin complicaciones. Asigna automáticamente cada ubicación de escaneo al destino correcto; gestiónalos de forma centralizada.</p><span class=\"d01-fcard-tag\">Franchise · Chain</span></article></div></section><section class=\"d01-fgroup\"><div class=\"d01-fgroup-head\"><span class=\"d01-fgroup-id\"><b>03</b> · Grupo de capacidades</span><h2 class=\"d01-fgroup-name\">Enrutamiento <em>por horario.</em></h2><p class=\"d01-fgroup-blurb\">Hora del día, día de la semana, fechas del calendario. Comportamiento que cambia según una programación, sin intervención humana.</p></div><div class=\"d01-fcards\"><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">07 · Hours</span><h3 class=\"d01-fcard-title\">Enrutamiento por horario</h3><p class=\"d01-fcard-desc\">Distintos destinos por hora, día o rango de fechas. Menú de brunch antes de las 11, cena después de las 17, oferta especial los sábados.</p><span class=\"d01-fcard-tag\">Hours · Days</span></article><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">08 · Live</span><h3 class=\"d01-fcard-title\">Actualizaciones instantáneas</h3><p class=\"d01-fcard-desc\">Los cambios se propagan en menos de un segundo. Sin purga de CDN, sin recompilación, sin espera. Aplica un cambio y el siguiente escaneo lo recoge.</p><span class=\"d01-fcard-tag\">Sub-second</span></article><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">09 · Schedule</span><h3 class=\"d01-fcard-title\">Programación de campañas</h3><p class=\"d01-fcard-desc\">Define fechas de inicio y fin para cualquier código. Lanza una campaña el lunes a las 9:00 y termínala el domingo a medianoche, sin cambios manuales.</p><span class=\"d01-fcard-tag\">Auto · Calendar</span></article></div></section><section class=\"d01-fgroup\"><div class=\"d01-fgroup-head\"><span class=\"d01-fgroup-id\"><b>04</b> · Grupo de capacidades</span><h2 class=\"d01-fgroup-name\">Analítica <em>y equipo.</em></h2><p class=\"d01-fgroup-blurb\">Inteligencia en tiempo real, colaboración con permisos por rol, entrega mobile-first. Opéralo como el resto de tu stack.</p></div><div class=\"d01-fcards\"><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">10 · Insight</span><h3 class=\"d01-fcard-title\">Analítica avanzada</h3><p class=\"d01-fcard-desc\">Seguimiento de escaneos en tiempo real con inteligencia de ubicación, dispositivo, navegador, hora y conversión. Mapas de calor, embudos, exportaciones e integraciones.</p><span class=\"d01-fcard-tag\">Geo · Funnel · Export</span></article><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">11 · Team</span><h3 class=\"d01-fcard-title\">Colaboración en equipo</h3><p class=\"d01-fcard-desc\">Invita a compañeros con permisos por rol. Registros de actividad, aprobaciones y multitenencia para agencias y franquicias.</p><span class=\"d01-fcard-tag\">Roles · Audit</span></article><article class=\"d01-fcard\"><span class=\"d01-fcard-id\">12 · Mobile</span><h3 class=\"d01-fcard-title\">Optimizado para móvil</h3><p class=\"d01-fcard-desc\">Detección inteligente de dispositivos, páginas de destino adaptables, primer renderizado rápido. Funciona sin fallos en iOS, Android y el resto.</p><span class=\"d01-fcard-tag\">iOS · Android</span></article></div></section></div><section class=\"d01-fcta\"><div class=\"d01-fcta-inner\"><div><span class=\"d01-fcta-kicker\">D01 / READY</span><h2 class=\"d01-fcta-headline\">Doce funciones. <em>Un código editable.</em></h2></div><div class=\"d01-fcta-actions\"><a class=\"d01-fcta-primary\" href=\"https://app.scanfence.com/signup\">Comenzar prueba gratuita</a><a class=\"d01-fcta-secondary\" href=\"/contact/\">Hablar con ventas</a></div></div></section>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t",
