---
import {
  getPages,
  getAllPosts,
  rewriteWPLinks,
  rewriteSchemaUrls,
  demoteExtraH1s,
  normalizeHeadingLevels,
  relabelElementorToc,
  fixLegacyProductName,
} from '../lib/wordpress';
import PageLayout from '../layouts/PageLayout.astro';
import { DEFAULT_LOCALE } from '../i18n/config';
import {
  descriptionForPage,
  faqSchemaFromAccordions,
  howToSchemasFromDetails,
  stripInlineFaqSchema,
} from '../lib/seo';

export async function getStaticPaths() {
  const [pages, posts] = await Promise.all([getPages(), getAllPosts()]);
  const postSlugs = new Set(posts.map(p => p.slug));
  const excludedSlugs = ['homepage', 'blog', 'sample-page', 'contact', 'pricing'];
  return pages
    .filter(p => !excludedSlugs.includes(p.slug))
    .map(p => ({ params: { slug: p.slug }, props: { page: p, postSlugs: [...postSlugs] } }));
}

const locale = DEFAULT_LOCALE;
const { page, postSlugs } = Astro.props;
const seo = page.yoast_head_json;
const knownPostSlugs = new Set<string>(postSlugs);
// `relabelElementorToc` runs on the English route only: the widget prints the
// WordPress install's language, so the source page ships a German
// "Inhaltsverzeichnis" while every translated copy is already correct.
const rewrittenContent = normalizeHeadingLevels(
  relabelElementorToc(
    demoteExtraH1s(
      fixLegacyProductName(rewriteWPLinks(page.content.rendered, knownPostSlugs)),
    ),
    'Contents',
  ),
);
const fixedSchema = seo?.schema
  ? rewriteSchemaUrls(seo.schema, knownPostSlugs)
  : undefined;

// Answer-engine pass on the FAQ page: WordPress ships three partial FAQPage
// blocks covering 9 of the 31 visible questions. Replace them with one
// FAQPage built from the accordions actually on the page, so every answer is
// extractable and the URL carries a single question set.
const isFaqPage = page.slug === 'faq';
const faqCanonical = seo?.canonical ?? `https://scanfence.com/${page.slug}/`;
const faqSchema = isFaqPage
  ? faqSchemaFromAccordions(rewrittenContent, faqCanonical)
  : undefined;
const content = faqSchema ? stripInlineFaqSchema(rewrittenContent) : rewrittenContent;
// JSON-LD permits a top-level array, which lets the page carry Yoast's graph
// and the FAQPage side by side without either overwriting the other.
// The manual's nine step-by-step procedures, so a "how do I …" query has a
// procedure to match instead of one undifferentiated WebPage.
const howToSchemas =
  page.slug === 'documentation'
    ? howToSchemasFromDetails(rewrittenContent, `https://scanfence.com/${page.slug}/`)
    : [];
const extraSchemas = [...(faqSchema ? [faqSchema] : []), ...howToSchemas];
const pageSchema = extraSchemas.length
  ? [...(fixedSchema ? [fixedSchema] : []), ...extraSchemas]
  : fixedSchema;
---

<PageLayout
  title={seo?.title || page.title.rendered}
  pageTitle={page.title.rendered}
  description={descriptionForPage(page.slug, seo?.description)}
  canonical={seo?.canonical}
  ogImage={seo?.og_image?.[0]?.url}
  jsonLd={pageSchema}
  locale={locale}
>
  <Fragment set:html={content} />
</PageLayout>
