---
import BaseLayout from '../layouts/BaseLayout.astro';
import QrRestaurantsPage from '../components/QrRestaurantsPage.astro';
import { resolveLocale, localizedUrl, t } from '../i18n/t';

const locale = resolveLocale(Astro.currentLocale);
const title = t('qrrestaurants.title', locale);
const description = t('qrrestaurants.description', locale);
const canonical = `https://scanfence.com${localizedUrl('/qr-codes-for-restaurants/', locale)}`;
---

<BaseLayout title={title} description={description} canonical={canonical} locale={locale}>
  <QrRestaurantsPage locale={locale} />
</BaseLayout>
