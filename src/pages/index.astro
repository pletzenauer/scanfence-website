---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Receipt from '../components/Receipt.astro';
import CTA from '../components/CTA.astro';
import DemoTeaser from '../components/DemoTeaser.astro';
import { resolveLocale, localizedUrl, t } from '../i18n/t';
import { ORG_ID } from '../lib/seo';

const locale = resolveLocale(Astro.currentLocale);
const title = t('home.title', locale);
const description = t('site.description', locale);
const canonical = `https://scanfence.com${localizedUrl('/', locale)}`;

// Pricing is USD and matches /pricing/ (Basic 4.99 → Professional 44.99).
// This block previously declared EUR with no price at all, contradicting the
// pricing page's AggregateOffer and leaving the offer unpriceable.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ScanFence',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description,
  url: canonical,
  publisher: { '@id': ORG_ID },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '4.99',
    highPrice: '44.99',
    offerCount: 3,
    availability: 'https://schema.org/InStock',
    url: `https://scanfence.com${localizedUrl('/pricing/', locale)}`,
  },
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <Header />
  <main>
    <Hero />
    <div class="container">
      <div class="metadata-strip">
        <span>{t('common.metadata.qrDynamic', locale)}</span>
        <span>{t('common.metadata.gpsGeofenced', locale)}</span>
        <span>{t('common.metadata.timeAware', locale)}</span>
        <span>{t('common.metadata.euIreland', locale)}</span>
        <span>{t('common.metadata.soc2', locale)}</span>
      </div>
    </div>
    <Features />
    <DemoTeaser />
    <Receipt />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
